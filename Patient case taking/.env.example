# CAREPATH AI - Environment Configuration Template
# Copy this file to .env and provide your deployment-specific values.
# NEVER commit sensitive production passwords or private keys to source control.

# Application Server
PORT=4000
NODE_ENV=development

# Session & Security
# Generate a cryptographically random secret in production (e.g., openssl rand -hex 32)
SESSION_SECRET=your_secure_random_session_secret_here
COOKIE_SECURE=false

# Demo Evaluation Credentials (Optional overrides for local testing)
DEMO_DOCTOR_PASSWORD=your_demo_doctor_password_here
DEMO_ADMIN_PASSWORD=your_demo_admin_password_here
DEMO_PATIENT_PASSWORD=your_demo_patient_password_here

# AI Engine Provider Configuration
# Supported values: local (default, offline, deterministic) | gemini | openai
AI_PROVIDER=local
AI_API_KEY=your_optional_llm_api_key_here
